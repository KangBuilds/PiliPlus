platform :ios, '26.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  pip_controller = File.join(__dir__, '.symlinks/plugins/media_kit_video/ios/Classes/plugin/PictureInPictureController.swift')
  if File.exist?(pip_controller)
    contents = File.read(pip_controller)
    {
      'UIApplication.didEnterBackgroundNotification' => 'UIScene.didEnterBackgroundNotification',
    }.each do |old, new|
      raise 'media_kit_video PiP lifecycle changed upstream' unless contents.include?(new) || contents.sub!(old, new)
    end
    foreground_observers = [
      'UIApplication.willEnterForegroundNotification',
      'UIScene.willEnterForegroundNotification',
      'UIScene.didActivateNotification',
    ].map do |notification|
      <<~SWIFT
        NotificationCenter.default.addObserver(
          self,
          selector: #selector(willEnterForeground),
          name: #{notification},
          object: nil
        )
      SWIFT
    end
    foreground_observers.each { |observer| observer.gsub!(/^/, '    ') }
    restore_handler = <<~'SWIFT'
        channel.setMethodCallHandler { [weak self] call, result in
          guard call.method == "PictureInPicture.Restore" else {
            result(FlutterMethodNotImplemented)
            return
          }
          self?.willEnterForeground()
          result(nil)
        }
    SWIFT
    restore_handler.gsub!(/^/, '    ')
    if (observer = foreground_observers.find { |candidate| contents.include?(candidate) })
      contents.sub!(observer, contents.include?(restore_handler) ? '' : restore_handler)
    end
    raise 'media_kit_video PiP restore channel changed upstream' unless contents.include?(restore_handler)
    {
      "    case .requesting:\n      cancelRequest(reason: \"returnedToForeground\")\n" => "    case .requesting:\n      cancelRequest(reason: \"returnedToForeground\")\n      controller?.stopPictureInPicture()\n",
      "    case .restoring:\n      break\n" => "    case .restoring:\n      controller?.stopPictureInPicture()\n",
    }.each do |old, new|
      raise 'media_kit_video PiP restore lifecycle changed upstream' unless contents.include?(new) || contents.sub!(old, new)
    end
    old = <<~'SWIFT'
          let duration = configuration?.duration ?? 0
          return CMTimeRange(
            start: .zero,
    SWIFT
    old.gsub!(/^/, '    ')
    new = <<~'SWIFT'
          guard let configuration, let timebase = sourceLayer?.controlTimebase else {
            return .invalid
          }
          let duration = configuration.duration
          let start = CMTimeSubtract(
            CMTimebaseGetTime(timebase),
            CMTime(seconds: configuration.position, preferredTimescale: 600)
          )
          return CMTimeRange(
            start: start,
    SWIFT
    new.gsub!(/^/, '    ')
    unless contents.include?(new)
      raise 'media_kit_video PiP playback range changed upstream' unless contents.sub!(old, new)
    end
    File.write(pip_controller, contents)
  end

  inline_video_view = File.join(__dir__, '.symlinks/plugins/media_kit_video/ios/Classes/plugin/InlineVideoView.swift')
  if File.exist?(inline_video_view)
    contents = File.read(inline_video_view)
    old = <<~'SWIFT'
        private var formatDescription: CMVideoFormatDescription?
        private var formatSize = CGSize.zero
    SWIFT
    old.gsub!(/^/, '  ')
    legacy = old + <<~'SWIFT'.gsub(/^/, '  ')
        private var lastPixelBuffer: CVPixelBuffer?
        private var restoredFramePending = false
    SWIFT
    new = <<~'SWIFT'
        private var formatDescription: CMVideoFormatDescription?
        private var formatSize = CGSize.zero
        private var lastPixelBuffer: CVPixelBuffer?
    SWIFT
    new.gsub!(/^/, '  ')
    contents.sub!(legacy, new)
    unless contents.include?(new)
      raise 'media_kit_video inline frame state changed upstream' unless contents.sub!(old, new)
    end

    old = <<~'SWIFT'
        backgroundColor = .black
        displayLayer.videoGravity = .resize
    SWIFT
    old.gsub!(/^/, '    ')
    new = <<~'SWIFT'
        backgroundColor = .black
        displayLayer.videoGravity = .resize
        NotificationCenter.default.addObserver(
          self,
          selector: #selector(restoreLastFrame),
          name: UIApplication.didBecomeActiveNotification,
          object: nil
        )
    SWIFT
    new.gsub!(/^/, '    ')
    unless contents.include?(new)
      raise 'media_kit_video inline view setup changed upstream' unless contents.sub!(old, new)
    end

    legacy = <<~'SWIFT'
        deinit {
          NotificationCenter.default.removeObserver(self)
        }

        @objc private func restoreLastFrame() {
          guard let pixelBuffer = lastPixelBuffer else { return }
          restoredFramePending = false
          displayLayer.flush()
          enqueue(pixelBuffer: { pixelBuffer })
          restoredFramePending = true
        }
    SWIFT
    legacy.gsub!(/^/, '  ')
    new = <<~'SWIFT'
        deinit {
          NotificationCenter.default.removeObserver(self)
        }

        @objc private func restoreLastFrame() {
          guard let pixelBuffer = lastPixelBuffer else { return }
          displayLayer.flush()
          enqueue(pixelBuffer: { pixelBuffer })
        }
    SWIFT
    new.gsub!(/^/, '  ')
    unless contents.include?(new)
      old = <<~'SWIFT'
          @available(*, unavailable)
          required init?(coder: NSCoder) {
      SWIFT
      old.gsub!(/^/, '  ')
      raise 'media_kit_video inline view lifecycle changed upstream' unless contents.sub!(legacy, new) || contents.sub!(old, new + "\n" + old)
    end
    contents.gsub!(legacy, '')

    legacy = <<~'SWIFT'
        func enqueue(pixelBuffer provider: () -> CVPixelBuffer?) {
          if restoredFramePending {
            displayLayer.flushAndRemoveImage()
            restoredFramePending = false
          }
          if displayLayer.status == .failed {
    SWIFT
    legacy.gsub!(/^/, '  ')
    new = <<~'SWIFT'
        func enqueue(pixelBuffer provider: () -> CVPixelBuffer?) {
          if displayLayer.status == .failed {
    SWIFT
    new.gsub!(/^/, '  ')
    unless contents.include?(new)
      raise 'media_kit_video inline frame enqueue lifecycle changed upstream' unless contents.sub!(legacy, new)
    end

    old = "      let pixelBuffer = provider()\n    else { return }\n\n    let size = CGSize(\n"
    new = "      let pixelBuffer = provider()\n    else { return }\n    lastPixelBuffer = pixelBuffer\n\n    let size = CGSize(\n"
    unless contents.include?(new)
      raise 'media_kit_video inline frame enqueue changed upstream' unless contents.sub!(old, new)
    end
    File.write(inline_video_view, contents)
  end

  # ponytail: remove when permission_handler_apple adds its own include guard.
  Dir.glob(File.join(__dir__, 'Flutter/ephemeral/Packages/.packages/permission_handler_apple-*/Sources/permission_handler_apple/PermissionHandlerEnums.h')).each do |header|
    contents = File.read(header)
    File.write(header, "#pragma once\n#{contents}") unless contents.start_with?('#pragma once')
  end

  webview_storyboard = File.join(__dir__, '.symlinks/plugins/flutter_inappwebview_ios/ios/Storyboards/WebView.storyboard')
  if File.exist?(webview_storyboard) && (storyboard = File.read(webview_storyboard)).sub!(' version="2048"', '')
    File.write(webview_storyboard, storyboard)
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '26.0'
      # ponytail: suppress vendored Swift warnings until the plugins support the current SDK.
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      next unless target.name == 'permission_handler_apple'

      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end
  installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '2660'
end
